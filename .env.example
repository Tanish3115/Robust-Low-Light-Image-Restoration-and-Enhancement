LUMA_OUTPUT_DIR=outputs
LUMA_CHECKPOINT=checkpoints/LOL_v1.pth
LUMA_DEVICE=auto
LUMA_MAX_UPLOAD_MB=20
LUMA_MAX_INPUT_PIXELS=40000000
LUMA_MAX_PROCESS_SIDE=2048
LUMA_TILE_SIZE=256
LUMA_TILE_OVERLAP=32
LUMA_RESULT_TTL_HOURS=24
LUMA_MAX_RESULTS=60
LUMA_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
LUMA_ENABLE_IQA=false
LUMA_METRIC_CACHE_DIR=checkpoints/metrics
LUMA_MAX_BATCH_FILES=32
LUMA_MAX_BATCH_MB=100
